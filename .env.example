# Скопируйте в .env и заполните. Сам .env в git не попадает.

# SQLite-файл базы (путь от корня проекта)
DATABASE_URL="file:./data/azart.db"

# Ключ подписи сессий Auth.js. Сгенерировать: npx auth secret  (или: openssl rand -base64 32)
AUTH_SECRET=""

# VK API: сервисный ключ доступа приложения (vk.com/apps?act=manage → приложение → Ключи доступа).
# Ключ используется только на сервере и никогда не попадает в браузер.
VK_SERVICE_TOKEN=""
# Короткое имя группы из адреса vk.com/<имя>
VK_GROUP_DOMAIN="sop_azart"
